{
  "name": "invokyr-save-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Editor web (100% client-side) de saves do Invokyr. Não afiliado à Ludogram.",
  "license": "MIT",
  "author": "Daniel Gonçalves Araujo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dandgabr/invokyr-save-editor.git"
  },
  "bugs": {
    "url": "https://github.com/dandgabr/invokyr-save-editor/issues"
  },
  "homepage": "https://invokyr.dan.seg.br/",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "e2e": "playwright test",
    "format": "biome check --write .",
    "check:game": "node scripts/check-game-build.mjs",
    "docs:lint": "rumdl check ."
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "fflate": "0.8.3",
    "immer": "11.2.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fast-check": "4.10.2",
    "rumdl": "0.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
